// Amazon Seller Inventory — data model
//
// The central idea: cost price is never a column on `Product`. Every purchase
// creates a PurchaseLot with its own unit cost and date, so a product bought at
// ₹100 in June and ₹80 in July is two lots, not an overwritten field. Price
// history, stock on hand, stock valuation and "who bought it at what price" are
// all queries over lots rather than extra bookkeeping.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
}

enum MovementType {
  IN // stock arriving from a purchase lot
  SALE
  RETURN
  DAMAGE
  ADJUST
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(STAFF)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  purchaseLots   PurchaseLot[]
  movements      StockMovement[]
  sellingPrices  SellingPrice[]
  auditLogs      AuditLog[]
  vendorPayments VendorPayment[]
}

enum PaymentMode {
  CASH
  UPI
  BANK
  OTHER
}

model Vendor {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  gstin     String?
  address   String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseLots PurchaseLot[]
  payments     VendorPayment[]

  @@index([name])
}

// Money actually handed to a vendor. Deliberately not a "paid" flag on the
// lot: partial payment is the normal case, so what a vendor is owed is a
// balance — the sum of their lots minus the sum of their payments — and both
// sides of that subtraction need their own dated, attributed entries.
model VendorPayment {
  id          String      @id @default(cuid())
  vendorId    String
  amount      Decimal     @db.Decimal(12, 2)
  paidAt      DateTime
  mode        PaymentMode @default(UPI)
  lotId       String? // set when the payment was made against a specific lot
  note        String?
  createdById String
  createdAt   DateTime    @default(now())

  vendor    Vendor       @relation(fields: [vendorId], references: [id])
  lot       PurchaseLot? @relation(fields: [lotId], references: [id])
  createdBy User         @relation(fields: [createdById], references: [id])

  @@index([vendorId, paidAt])
  @@index([createdById])
}

model Product {
  id           String   @id @default(cuid())
  sku          String   @unique
  asin         String? // Amazon identifier, kept for a future SP-API sync
  title        String
  description  String?
  imageUrl     String?
  category     String?
  unit         String   @default("pcs")
  // Set and updated from the purchase flow, not the product form — the
  // reorder point is something you know while buying, not while cataloguing.
  reorderLevel Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  purchaseLots  PurchaseLot[]
  movements     StockMovement[]
  sellingPrices SellingPrice[]

  @@index([title])
  @@index([category])
}

// One purchase of one product from one vendor at one price. The unit of both
// costing and price history.
model PurchaseLot {
  id           String   @id @default(cuid())
  productId    String
  vendorId     String
  // quantity is always the canonical total in pieces. When the purchase was
  // made in cartons, the breakdown is stored too (quantity = cartons *
  // unitsPerCarton); the purchase form pre-fills unitsPerCarton from this
  // product's most recent lot, since carton size lives on purchases, not on
  // the product.
  quantity     Int
  cartons        Int?
  unitsPerCarton Int?
  unitCost     Decimal  @db.Decimal(12, 2)
  purchaseDate DateTime
  invoiceNo    String?
  notes        String?
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  product   Product         @relation(fields: [productId], references: [id])
  vendor    Vendor          @relation(fields: [vendorId], references: [id])
  createdBy User            @relation(fields: [createdById], references: [id])
  movements StockMovement[]
  payments  VendorPayment[]

  @@index([productId, purchaseDate])
  @@index([vendorId, purchaseDate])
  @@index([createdById])
}

// Every change in stock on hand. An IN movement is written automatically when a
// lot is created; everything else is entered by a user. Stock on hand is the
// signed sum of these, never a mutable counter — a counter drifts, a ledger
// reconciles.
model StockMovement {
  id        String       @id @default(cuid())
  productId String
  lotId     String? // which lot the stock came out of (FIFO), null for ADJUST
  type      MovementType
  quantity  Int // always positive; `type` carries the direction
  note      String?
  occurredAt   DateTime  @default(now())
  createdById  String
  createdAt    DateTime  @default(now())

  product   Product      @relation(fields: [productId], references: [id])
  lot       PurchaseLot? @relation(fields: [lotId], references: [id])
  createdBy User         @relation(fields: [createdById], references: [id])

  @@index([productId, occurredAt])
  @@index([createdById])
}

// The Amazon listing price over time. Deliberately separate from cost: selling
// price moves for reasons that have nothing to do with what you paid, and
// margin is only meaningful when the two are tracked independently.
model SellingPrice {
  id            String   @id @default(cuid())
  productId     String
  price         Decimal  @db.Decimal(12, 2)
  effectiveFrom DateTime
  note          String?
  createdById   String
  createdAt     DateTime @default(now())

  product   Product @relation(fields: [productId], references: [id])
  createdBy User    @relation(fields: [createdById], references: [id])

  @@index([productId, effectiveFrom])
}

// Written by Prisma middleware on every mutation rather than by hand at each
// call site — a log that depends on the author remembering it is a log with
// holes in it.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String // CREATE | UPDATE | DELETE | LOGIN | LOGOUT
  entity    String // Product | Vendor | PurchaseLot | ...
  entityId  String?
  before    Json?
  after     Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([actorId, createdAt])
  @@index([entity, entityId])
  @@index([createdAt])
}
